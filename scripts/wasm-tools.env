# Pinned tools for building the browser bundle that ships inside the wheel.
#
# scripts/install-wasm-tools.sh downloads exactly these releases and refuses
# any file whose SHA-256 differs from the one below. scripts/build-wasm.sh
# refuses to build unless the tools on PATH report exactly these versions,
# and runs wasm-pack with --mode no-install so it never downloads anything
# itself.
#
# Bumping is by hand, never by bot: change a version, download the release
# asset, hash it, and cross-check that hash against an independent source
# (GitHub's asset digest or the release's own checksum file) before
# committing. Hashes are for the x86_64 Linux assets CI uses.

# https://github.com/wasm-bindgen/wasm-pack/releases
WASM_PACK_VERSION=0.15.1
WASM_PACK_SHA256=410101009739b9d01c7d5affaaad6e9c9a24b4cba6791a4805db8e89b9bf7af2

# https://github.com/wasm-bindgen/wasm-bindgen/releases
# must equal the wasm-bindgen crate version in rust/Cargo.lock
WASM_BINDGEN_VERSION=0.2.126
WASM_BINDGEN_SHA256=064948d58e2d6c0a745216477a639ba696216d6309aaa902939d1b865b1d869d

# https://github.com/WebAssembly/binaryen/releases (provides wasm-opt)
BINARYEN_VERSION=117
BINARYEN_SHA256=3dc677006555b355ea2da5e82602065a161d5e83eaefd3f759afa00b96e83212
